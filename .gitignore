# ── root ──
.env
.env.*
!.env.example
backups/
*.dump
*.dump.gpg
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp

# ── api (Laravel) ──
api/vendor/
api/node_modules/
api/.env
api/.env.*
!api/.env.example
api/storage/*.key
api/storage/app/*
!api/storage/app/.gitkeep
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/storage/logs/*
api/bootstrap/cache/*.php
api/.phpunit.result.cache
api/.phpunit.cache/
api/public/storage
api/public/build/

# ── web (Nuxt) ──
web/node_modules/
web/.nuxt/
web/.output/
web/.nitro/
web/.cache/
web/dist/
web/.env
web/.env.*
!web/.env.example
web/coverage/

# ── mobile (Flutter) — see mobile/.gitignore for details ──
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist
mobile/android/key.properties

# ── tooling ──
node_modules/
.redocly-cache/

# Local database dumps (contain data — never commit)
database-export/
