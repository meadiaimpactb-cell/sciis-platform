# ───────────────────────────────────────────────────────────────
# SCIIS platform — root environment for docker compose
# انسخ هذا الملف إلى .env وعدّل القيم. لا تُودِع .env في git أبدًا (SEC-04).
# ───────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=sciis
APP_ENV=local                      # local | testing | staging | production
APP_DEBUG=true                     # false in staging/production
APP_KEY=                           # generate: make key  (php artisan key:generate --show)
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar

# Ports exposed on the host
API_PORT=8000
WEB_PORT=3000
MAILPIT_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
HORIZON_PATH=horizon

# ── PostgreSQL 16 ──
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sciis
DB_USERNAME=sciis
DB_PASSWORD=change-me-local

# ── Redis 7 ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ── Object storage (S3-compatible; MinIO locally, KSA-resident bucket in prod — PRV-05) ──
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=sciis
AWS_SECRET_ACCESS_KEY=change-me-local-minio
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=sciis-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
DOCUMENTS_SIGNED_URL_MINUTES=10

# ── Mail (Mailpit locally) ──
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@sciis.sa
MAIL_FROM_NAME="SCIIS"

# ── SMS OTP (KSA provider; log driver locally) ──
SMS_DRIVER=log                     # log | unifonic | msegat
SMS_SENDER=SCIIS
SMS_API_KEY=

# ── Feature flags (mirror settings.features.*; env wins at boot) ──
FEATURE_PAYMENTS=false
FEATURE_ENGLISH=false
FEATURE_BROWSE_ALL=false
FEATURE_WATERMARK=false
FEATURE_DARK_MODE=false

# ── Payments (Moyasar) — unused while FEATURE_PAYMENTS=false ──
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ── Antivirus scanning of uploads (DOC-01) ──
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Observability ──
LOG_CHANNEL=stack
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Web (Nuxt) ──
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_DEFAULT_LOCALE=ar
