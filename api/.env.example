APP_NAME="SCIIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_VERSION=1.0.0
APP_GIT_SHA=

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_DOMAIN=localhost

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sciis
DB_USERNAME=sciis
DB_PASSWORD=secret
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
CACHE_PREFIX=sciis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Production (Hostinger SMTP): MAIL_SCHEME=smtps, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465; quote passwords with '…'.
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@sciis.sa"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
DOCUMENTS_DISK=s3
# SEC-01: encrypt document files at rest when DOCUMENTS_DISK is not S3 (key derived from APP_KEY).
# After rotating APP_KEY, list the old key(s) in APP_PREVIOUS_KEYS so existing files stay readable.
DOCUMENTS_ENCRYPT_AT_REST=true
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=sciis-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ----- SCIIS -----
FEATURE_PAYMENTS=false
FEATURE_ENGLISH=false
FEATURE_BROWSE_ALL=false
FEATURE_WATERMARK=false
FEATURE_DARK_MODE=false

SCIIS_2FA_ENFORCE_STAFF=true
SCIIS_VERIFICATION_OPTIONAL=false
# Phone OTP (ACC-01): turn off only while no SMS provider is configured; e-mail verification stays mandatory.
SCIIS_PHONE_VERIFICATION=true
SCIIS_SMS_DRIVER=log
# BKP-01 — php artisan backup:run (scheduled daily). Keep the path outside the web root.
SCIIS_BACKUP_PATH=
SCIIS_BACKUP_KEEP_DAYS=14
SCIIS_MYSQLDUMP=mysqldump
SCIIS_SCAN_DRIVER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCIIS_SIGNED_URL_MINUTES=10
# AGR-05 — agreement e-signature driver: simple (click-to-sign with consent) until a licensed provider is configured
SCIIS_SIGNATURE_DRIVER=simple

UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=SCIIS

# NTF-04 — WhatsApp key alerts (status changes, meeting invites) for users whose preferred contact is WhatsApp
# and who enabled it in their notification preferences. Driver: log (default) | cloud_api (Meta WhatsApp Cloud API).
# Each alert uses a template approved in WhatsApp Manager (names below; leave one empty to disable that alert).
SCIIS_WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_OPPORTUNITY_STATUS=sciis_opportunity_status
WHATSAPP_TEMPLATE_MEMBERSHIP_DECISION=sciis_membership_status
WHATSAPP_TEMPLATE_MEETING_INVITE=sciis_meeting_invite
WHATSAPP_LANGUAGE_AR=ar
WHATSAPP_LANGUAGE_EN=en

# ACC-08 — organisation accounts: colleague invitation validity (days) and members per organisation.
SCIIS_ORG_INVITATION_DAYS=7
SCIIS_ORG_MAX_MEMBERS=20

# ACC-09 — national identity verification (Nafath). none = hidden; nafath needs the credentials issued when the
# platform is onboarded with the Nafath service (Elm); fake = local demos only (refused in production).
SCIIS_IDENTITY_DRIVER=none
NAFATH_BASE_URL=
NAFATH_APP_ID=
NAFATH_APP_KEY=
NAFATH_SERVICE=DigitalServiceEnrollmentWithoutBio
NAFATH_TTL_SECONDS=180
NAFATH_TIMEOUT=10

PAYMENT_GATEWAY=moyasar
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

HORIZON_DOMAIN=null
HORIZON_PATH=horizon
SENTRY_LARAVEL_DSN=
