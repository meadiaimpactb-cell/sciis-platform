APP_NAME="SCIIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_VERSION=1.0.0
APP_GIT_SHA=

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_DOMAIN=localhost

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sciis
DB_USERNAME=sciis
DB_PASSWORD=secret
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
CACHE_PREFIX=sciis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@sciis.sa"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
DOCUMENTS_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=sciis-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ----- SCIIS -----
FEATURE_PAYMENTS=false
FEATURE_ENGLISH=false
FEATURE_BROWSE_ALL=false
FEATURE_WATERMARK=false
FEATURE_DARK_MODE=false

SCIIS_2FA_ENFORCE_STAFF=true
SCIIS_SMS_DRIVER=log
SCIIS_SCAN_DRIVER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCIIS_SIGNED_URL_MINUTES=10

UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=SCIIS

PAYMENT_GATEWAY=moyasar
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

HORIZON_DOMAIN=null
HORIZON_PATH=horizon
SENTRY_LARAVEL_DSN=
