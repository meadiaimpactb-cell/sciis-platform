# عنوان الـ API الحقيقي (Laravel) — يُستخدم عندما يكون NUXT_PUBLIC_API_MOCK=false
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# وضع المحاكاة: true = البيانات الافتراضية المدمجة (لا يحتاج خادمًا خلفيًا)
NUXT_PUBLIC_API_MOCK=true

# عنوان الموقع العام (لوسوم SEO/hreflang)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# الاسم المختصر للمنصة (SCII | SCIIS — القرار معلّق، انظر SPEC §7)
NUXT_PUBLIC_PLATFORM_SHORT_NAME=SCII
